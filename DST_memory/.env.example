# Скопируйте в DST_memory/.env (рядом с api.py).
# Файл подхватывается автоматически при старте api.py / run.py
# и не перезаписывает переменные, уже заданные в окружении.
#
# Для Docker: используйте .env в корне репозитория (см. .env.example рядом с docker-compose.yml).

OPENROUTER_API_KEY=

# URL вашего vLLM-сервера (локальный запуск — WSL или хост)
# SLOT_LLM_API_URL=http://localhost:8001/v1

# HF_TOKEN=
