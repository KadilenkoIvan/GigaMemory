{
  "_description": "Final LLM-only configuration - loads saved memory states and generates answers",
  "_note": "Use this mode after memory_only to generate answers using the saved memory states",

  "shared": {
    "_description": "Core validation parameters",
    "_note": "Dataset is not loaded in final_llm_only mode - items come from saved memory states",

    "dataset_path": "../../LongMemEval/longmemeval_s_cleaned.json",
    "output_dir": "./results_final_llm",
    "num_items_per_type": 10,
    "question_types": ["single-session-user", "single-session-preference", "multi-session", "knowledge-update"],

    "log_level": "INFO",
    "log_file": true,

    "save_memory_state": false,
    "save_intermediate": true
  },

  "batch_processing": {
    "_description": "Batch processing parameters for final LLM",

    "final_llm_batch_size": 5,
    "judge_batch_size": 5,
    "calculate_memory_hit_rate": false
  },

  "judge": {
    "_description": "Judge configuration (not used in final_llm_only mode)",
    "mode": "none",
    "model": "openai/gpt-oss-120b:free",
    "api_url": "https://openrouter.ai/api/v1",
    "api_key": "",
    "temperature": 0.0,
    "max_tokens": 1024,
    "local_model_path": "",
    "unload_between_items": false
  },

  "giga_memory": {
    "_description": "GigaMemory configuration for final LLM processing",
    "_note": "Only final LLM settings are used; memory processing settings are ignored",

    "importance_model_path": "",
    "importance_threshold": 0.25,

    "retrieval_top_k": 5,
    "graph_top_k_records": 20,
    "recent_history_pairs": 5,

    "disable_memory_gate": false,
    "memory_gate_use_stub": false,
    "memory_strategy": "full_graph_json",

    "llm_mode": "openrouter",
    "llm_api_url": "https://openrouter.ai/api/v1",
    "llm_api_key": "",
    "llm_model": "openai/gpt-oss-120b:free",
    "llm_temperature": 0.0,
    "llm_max_tokens": 1024,

    "slot_use_stub": false,
    "slot_model_path": "DST_memory/models/Meno-Lite-0.1",
    "slot_max_slots_per_message": 5,

    "use_ragu": true,
    "ragu_embedder_model": "deepvk/USER-bge-m3",
    "ragu_storage_path": "",

    "ttl_mode": "mode2",
    "ttl_semantic_dedup_enabled": true,
    "ttl_semantic_dedup_threshold": 0.9,
    "ttl_slot_overrides": {},

    "slot_context_enabled": false,
    "slot_context_max_facts": 10,
    "triplet_deletion_mode": "none",
    "deletion_use_pymorphy": false,

    "conflict_allow_multi_relation_same_object": true,
    "slot_model_enable_thinking": false,
    "slot_fallback_on_no_slots": true,
    "triplet_fallback_on_empty": true,

    "prompt_language": "ru",

    "unload_models_before_final_llm": true
  },

  "validation_mode": {
    "_description": "Final LLM-only mode configuration",
    "mode": "final_llm_only",
    "input_state_dir": "./results_memory_only",
    "_input_files": {
      "memory_only_states.json": "Required - contains all memory states from memory_only mode",
      "chunk_XXXX/": "Individual memory state directories"
    },
    "_output_files": {
      "intermediate_answers.json": "Generated answers with memory context for judge evaluation"
    },
    "_next_step": "Run judge_only mode with --input-answers-path pointing to intermediate_answers.json"
  }
}
