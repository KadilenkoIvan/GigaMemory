{
  "_description": "final_llm_only: OpenRouter, все три стратегии памяти + оба режима inactive_facts (active_only и with_inactive). graph_top_k_records=50 — в промпт попадают до 50 записей top-k (если меньше — все). Впишите llm_model, llm_tokenizer_model при необходимости, llm_api_key или OPENROUTER_API_KEY, и input_state_dir.",
  "_usage": "Из каталога validation/GigaMemory_full: python validate_longmemeval.py --config ./config_final_llm_only_openrouter_three_strategies_dual_inactive.json",

  "shared": {
    "dataset_path": "../../LongMemEval/longmemeval_s_cleaned.json",
    "output_dir": "./results_final_llm_only_extractor-model-Qwen_final-LLM-LLama",
    "num_items_per_type": 1000,
    "question_types": [
      "single-session-user",
      "single-session-preference",
      "multi-session",
      "knowledge-update"
    ],
    "log_level": "INFO",
    "log_file": true,
    "save_memory_state": false,
    "save_intermediate": true
  },

  "batch_processing": {
    "final_llm_batch_size": 1,
    "judge_batch_size": 1,
    "calculate_memory_hit_rate": false
  },

  "judge": {
    "mode": "none",
    "model": "",
    "api_url": "https://openrouter.ai/api/v1",
    "api_key": "",
    "temperature": 0.0,
    "max_tokens": 1024,
    "local_model_path": "",
    "unload_between_items": false
  },

  "giga_memory": {
    "memory_strategy": "full_graph_json",
    "llm_mode": "openrouter",
    "llm_api_url": "https://openrouter.ai/api/v1",
    "llm_api_key": "",
    "llm_model": "meta-llama/llama-3-8b-instruct",
    "llm_tokenizer_model": "Qwen/Qwen2.5-7B-Instruct",
    "llm_temperature": 0.0,
    "llm_max_tokens": 1024,
    "llm_max_context_tokens": 5000,
    "graph_top_k_records": 50,
    "prompt_language": "en",
    "unload_models_before_final_llm": true,
    "openrouter_http_referer": "",
    "openrouter_x_title": ""
  },

  "validation_mode": {
    "mode": "final_llm_only",
    "input_state_dir": "./result_Qwen35_10-by-cat_5-q-by-dialog/stage1",
    "input_answers_path": "",
    "final_llm_memory_strategies": [
      "full_graph_json",
      "relevant_slots_full",
      "topk_graph_records"
    ],
    "final_llm_memory_payload_mode": "with_metadata",
    "inactive_facts_memory_modes": ["active_only", "with_inactive"],
    "final_llm_resume_from_global_index": 165
  }
}
