# ── Validation ──────────────────────────────────────────────────────────────
# We commit only the lightweight, meaningful parts of validation/: the scripts,
# docs, config presets, the metric digests (validation/metrics/metrics-*.json)
# and the backing validation_results.json the README links to. Everything heavy
# is regenerated by the scripts and stays out of the repo.

# Huge raw run trees (vector DBs, per-dialogue DST snapshots, intermediate answers)
validation/GigaMemory_full/result_*/
validation/GigaMemory_full/results_final_llm_only_*/
validation/GigaMemory_full/results_memory_only_*/
validation/GigaMemory_full/pipeline_test_runs/
validation/GigaMemory_full/test_data/

# Per-run runtime state, wherever it lands
validation/**/__pycache__/
validation/**/chunk_*/
validation/**/ragu_storage/
validation/**/dst_state.json
validation/**/memory_only_states.json
validation/**/intermediate_answers.json
validation/**/giga_memory_validation_logs.json
validation/**/*.log
validation/**/*.html
validation/**/*.gml
validation/**/*.ipynb

