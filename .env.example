# Copy this file to .env (project root, same level as docker-compose.yml).
# Docker Compose automatically loads .env from the project root.

# ── API keys ──────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
HF_TOKEN=

# ── GigaMemory API ────────────────────────────────────────────────────────────
API_PORT=8000

# PyTorch variant for the Docker image build: cuda (default) or cpu
TORCH_EXTRA=cuda

# ── vLLM (used when running with --profile vllm) ─────────────────────────────
# Directory on the HOST that contains your model subfolder.
# Windows example:  MODEL_DIR=D:/Users/me/GigaMemory/models
# Linux/WSL example: MODEL_DIR=/mnt/d/Users/me/GigaMemory/models
MODEL_DIR=./models

# Name of the model subfolder inside MODEL_DIR
MODEL_NAME=Qwen3.5-4B-AWQ

# Port that vLLM exposes on the host (API connects to it internally via Docker DNS)
VLLM_PORT=8001

# vLLM tuning
VLLM_GPU_UTIL=0.65
VLLM_MAX_LEN=8192
VLLM_MAX_SEQS=4

# ── External vLLM (used WITHOUT --profile vllm) ───────────────────────────────
# When you run vLLM outside Docker (e.g. directly in WSL), set this so the
# API container knows where to reach it.
# On Docker Desktop (Windows/Mac):  http://host.docker.internal:8001/v1
# On Linux (native Docker):         http://172.17.0.1:8001/v1
# Leave empty when using --profile vllm (Docker DNS handles it automatically).
SLOT_LLM_API_URL=
